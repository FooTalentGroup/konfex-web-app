generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  email            String            @unique
  name             String?
  password         String
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  active           Boolean           @default(true)
  telegramMessages TelegramMessage[]
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String
  telefono      String?
  email         String?
  origen        String?
  instagramUser String?
  notas         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  pedidos       Pedido[]
  presupuestos  Presupuesto[]
}

model Producto {
  id                  Int                     @id @default(autoincrement())
  nombre              String                  @unique
  descripcion         String?
  activo              Boolean                 @default(true)
  tallas              String[]
  colores             String[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  manoDeObra          ManoDeObraPorProducto[]
  materiales          MaterialPorProducto[]
  pedidos             PedidoDetalle[]
  presupuestoDetalles PresupuestoDetalle[]
}

model Material {
  id           Int                   @id @default(autoincrement())
  nombre       String
  url_imagen   String?
  categoria    String
  unidadMedida String
  ancho        Float?
  peso         Float?
  colores      String[]
  proveedor    String
  precio       Float
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  productos    MaterialPorProducto[]

  @@index([categoria])
  @@index([precio])
  @@index([proveedor])
}

model ManoDeObra {
  id        Int                     @id @default(autoincrement())
  nombre    String
  costoHora Float?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  productos ManoDeObraPorProducto[]
}

model MaterialPorProducto {
  id         Int   @id @default(autoincrement())
  productoId Int
  materialId Int
  cantidad   Float

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, materialId])
  @@index([materialId])
  @@index([productoId])
}

model ManoDeObraPorProducto {
  id            Int        @id @default(autoincrement())
  productoId    Int
  manoDeObraId  Int
  cantidadHoras Float
  costoHora     Float?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  manoDeObra    ManoDeObra @relation(fields: [manoDeObraId], references: [id], onDelete: Cascade)
  producto      Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Presupuesto {
  id                         Int                  @id @default(autoincrement())
  numeroPresupuesto          Int                  @unique
  nombre                     String?
  clienteId                  Int?
  fechaCreacion              DateTime             @default(now())
  fechaVencimiento           DateTime?
  estado                     EstadoPresupuesto
  margenGananciaPorcentaje   Float
  gastosIndirectosPorcentaje Float
  totalCosto                 Float
  costosIndirectos           Float
  ganancias                  Float
  notas                      String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  pedido                     Pedido?
  cliente                    Cliente?             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  detalles                   PresupuestoDetalle[]
  adicionales                Adicional[]
}

model PresupuestoDetalle {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  productoId    Int
  descripcion   String?
  cantidad      Int
  costoUnitario Float
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id])

  @@index([presupuestoId])
}

model Adicional {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  nombre        String
  cantidad      Int
  monto         Float
  totalCosto    Float
  observaciones String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
}

model Pedido {
  id                   Int               @id @default(autoincrement())
  presupuestoId        Int               @unique
  clienteId            Int
  fechaCreacion        DateTime          @default(now())
  estado               EstadoPedido
  pagado               Boolean           @default(false)
  fechaEntregaEstimada DateTime?
  fechaEntregaReal     DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cliente              Cliente           @relation(fields: [clienteId], references: [id])
  presupuesto          Presupuesto       @relation(fields: [presupuestoId], references: [id])
  detalles             PedidoDetalle[]
  etapas               ProduccionEtapa[]
}

model PedidoDetalle {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  productoId     Int
  cantidad       Int
  talle          String?
  color          String?
  costoUnitario  Float
  precioUnitario Float
  subtotal       Float
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])
}

model ProduccionEtapa {
  id          Int       @id @default(autoincrement())
  pedidoId    Int
  etapa       String
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  responsable String?
  pedido      Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model TelegramMessage {
  id        Int      @id @default(autoincrement())
  chatId    String
  userId    Int? // Relación con tu tabla de usuarios si ya está registrado
  firstName String? // Nombre del usuario en Telegram
  lastName  String? // Apellido del usuario en Telegram
  username  String? // Username de Telegram
  text      String
  source    String   @default("telegram") // opcional, puede ser 'telegram' u otra fuente
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  VENCIDO
}

enum EstadoPedido {
  PENDIENTE
  EN_PRODUCCION
  LISTO
  ENTREGADO
  CANCELADO
}

enum Role {
  USER
  ADMIN
}

