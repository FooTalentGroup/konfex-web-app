generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  telefono      String?
  email         String?
  direccion     String?
  origen        String?
  instagramUser String?
  notas         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  pedidos       Pedido[]
  presupuestos  Presupuesto[]
  telegramMessages TelegramMessage[]
}

model Coleccion {
  id        Int       @id @default(autoincrement())
  codigo    Int       @unique
  nombre    String    @unique
  imagen    String?
  icono     String? 
  productos Producto[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Producto {
  id           Int       @id @default(autoincrement())
  codigo       Int    @unique
  nombre       String
  descripcion  String?
  activo       Boolean   @default(true)
  imagen       String?
  tallas       String[]
  colores      String[]

  /// Relación con colección

  mermaCantidad Float?
  mermaUnidad   String?
  mermaPrecio   Float?

  /// Relaciones existentes
  coleccionId  Int
  coleccion    Coleccion @relation(fields: [coleccionId], references: [id])
  
  manoDeObra          ManoDeObraPorProducto[]
  materiales          MaterialPorProducto[]

  pedidos             PedidoDetalle[]
  presupuestoDetalles PresupuestoDetalle[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([coleccionId])
}

model Categoria {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  materiales Material[]

  @@index([nombre])
}

model Material {
  id           Int                   @id @default(autoincrement())
  nombre       String
  url_imagen   String?
  categoriaId  Int
  categoria    Categoria             @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  unidadMedida String
  ancho        Float?
  peso         Float?
  colores      String[]
  proveedor    String
  precio       Float
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  productos    MaterialPorProducto[]

  @@index([categoriaId])
  @@index([precio])
  @@index([proveedor])
}

model ManoDeObra {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  costoHora Float    // precio asignado en el seed
  productos ManoDeObraPorProducto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialPorProducto {
  id         Int      @id @default(autoincrement())
  productoId Int
  materialId Int
  cantidad   Float

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, materialId])
  @@index([materialId])
  @@index([productoId])
}

model ManoDeObraPorProducto {
  id            Int      @id @default(autoincrement())
  productoId    Int
  manoDeObraId  Int
  cantidadHoras Float

  manoDeObra ManoDeObra @relation(fields: [manoDeObraId], references: [id], onDelete: Cascade)
  producto   Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productoId])
  @@index([manoDeObraId])
}

model Presupuesto {
  id                         Int                  @id @default(autoincrement())
  numeroPresupuesto          Int                  @unique
  nombre                     String?
  clienteId                  Int?
  fechaCreacion              DateTime             @default(now())
  fechaVencimiento           DateTime?
  estado                     EstadoPresupuesto
  margenGananciaPorcentaje   Float
  totalCosto                 Float
  gastosNegocioId            Int
  ganancias                  Float
  iva                        Float                @default(0)
  totalFinal                 Float                @default(0)
  notas                      String?
  origen                     String               @default("manual") // "telegram" | "manual"
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  pedido                     Pedido?
  cliente                    Cliente?             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  gastosNegocio              GastosNegocio        @relation(fields: [gastosNegocioId], references: [id], onDelete: Restrict)
  detalles                   PresupuestoDetalle[]
  adicionales                Adicional[]
}

model PresupuestoDetalle {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  productoId    Int
  descripcion   String?
  cantidad      Int
  costoUnitario Float
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [id])

  @@index([presupuestoId])
}

model Adicional {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  nombre        String
  cantidad      Int
  monto         Float
  totalCosto    Float
  tarifaEnvio   Float?      @default(0)
  observaciones String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
}

model GastosNegocio {
  id          Int           @id @default(autoincrement())
  nombre      String
  porcentaje  Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  presupuestos Presupuesto[]

  @@index([nombre])
}

model ImpuestoGeneral {
  id          Int       @id @default(autoincrement())
  nombre      String    @default("IVA")
  porcentaje  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Pedido {
  id                   Int               @id @default(autoincrement())
  presupuestoId        Int               @unique
  clienteId            Int
  fechaCreacion        DateTime          @default(now())
  estado               EstadoPedido      @default(NO_VISTO)
  pagado               Boolean           @default(false)
  fechaEntregaEstimada DateTime?
  fechaEntregaReal     DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cliente              Cliente           @relation(fields: [clienteId], references: [id])
  presupuesto          Presupuesto       @relation(fields: [presupuestoId], references: [id])
  detalles             PedidoDetalle[]
  etapas               ProduccionEtapa[]
}

model PedidoDetalle {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  productoId     Int
  cantidad       Int
  talle          String?
  color          String?
  costoUnitario  Float
  precioUnitario Float
  subtotal       Float
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])
}

model ProduccionEtapa {
  id          Int       @id @default(autoincrement())
  pedidoId    Int
  etapa       String
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  responsable String?
  pedido      Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model TelegramMessage {
  id            Int       @id @default(autoincrement())
  chatId        String
  clienteId     Int?
  firstName     String?
  lastName      String?
  username      String?
  leido         Boolean   @default(false)

  // Mensajes de texto
  text          String?

  // Archivos multimedia
  type          String?   @default("text") // "photo" | "video" | "audio" | "document" | "sticker" | etc.
  fileId        String?
  fileUniqueId  String?
  filePath      String?   // ruta interna de Telegram
  fileUrl       String?   // URL completa hacia el archivo
  mimeType      String?   // video/mp4, image/jpeg, application/pdf
  fileSize      Int?      // tamaño

  // Metadatos
  source        String    @default("telegram")
  timestamp     DateTime  @default(now())

  cliente       Cliente?  @relation(fields: [clienteId], references: [id])
}

model TelegramConversation {
  chatId        String   @id
  currentStep   Int      @default(1)
  formData      Json?    @default("{}")
  manualMode    Boolean  @default(false)
  lastMessageAt DateTime @default(now())
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  ACEPTADO
  RECHAZADO
  VENCIDO
}

enum EstadoPedido {
  NO_VISTO
  EN_COMPRA
  EN_PRODUCCION
  ENTREGADO
}

enum Role {
  USER
  ADMIN
}

